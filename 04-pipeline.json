        "messages": {
          "values": [
            {
              "content": "=あなたはセキュリティニュースの編集者です。下の CISA のアドバイザリをもとに、日本の IT 担当者向けの解説記事の下書きを作ってください。\n\nルール：\n- 原文にない事実や数字を書かない\n- 原文をそのまま訳さず、自分の構成でまとめる\n- CVE 番号、製品名、バージョンは原文のとおりに書く\n- 出力は JSON だけ。前後に説明文や ``` を付けない\n- 本文（body_html）は全体で1000字以内にまとめる\n\n\nJSON の形：\n{\n  \"title\": \"60字以内のタイトル\",\n  \"summary\": \"3文以内の要約\",\n  \"body_html\": \"<h2>何が起きたか</h2>...<h2>影響を受ける製品</h2>...<h2>やるべきこと</h2>...<p>出典：<a href=\\\"原文のURL\\\">CISA</a></p>\",\n  \"tags\": [\"タグ1\", \"タグ2\"],\n  \"source_url\": \"原文のURL\"\n}\n\n原文のタイトル：{{ $json.title }}\n原文のURL：{{ $json.link }}\n原文：\n{{ $json.contentSnippet }}"
            }
          ]
        },
        "options": {
          "maxTokens": 4000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        896,
        0
      ],
      "id": "b3f8ffeb-2396-488f-b821-0adcb56a0733",
      "name": "Message a model",
      "credentials": {
        "anthropicApi": {
          "id": "Wsy5BHpGsqDjwwDU",
          "name": "Claude API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Claude の返事から text のブロックを探す\nconst blocks = $input.item.json.content || [];\nconst textBlock = blocks.find(b => b.type === 'text');\nconst raw = textBlock ? textBlock.text : '';\n\n// 元の RSS 記事（Limit ノードの中身）\nconst src = $('Limit').item.json;\nconst srcText = (src.title || '') + ' ' + (src.contentSnippet || src.content || '');\n\nconst errors = [];\nconst warnings = [];\n\n// 2. JSON として読めるか\nlet draft = null;\ntry {\n   const start = raw.indexOf('{'), end = raw.lastIndexOf('}');\n  const cleaned = start >= 0 && end > start ? raw.slice(start, end + 1) : raw;\n  draft = JSON.parse(cleaned);\n} catch (e) {\nerrors.push('JSONとして読めない：' + e.message);\n}\n\nif (draft) {\n  // 3. 必須の項目\n  for (const key of ['title', 'summary', 'body_html', 'source_url']) {\n    if (!draft[key]) errors.push(`${key} がない`);\n  }\n  const title = draft.title || '';\n  const body = draft.body_html || '';\n  const bodyText = body.replace(/<[^>]+>/g, '');\n\n  // 4. 文字数\n  if (title.length > 60) errors.push(`タイトルが長い（${title.length}字）`);\n  if (bodyText.length < 600) warnings.push(`本文が短い（${bodyText.length}字）`);\n  if (bodyText.length > 1500) warnings.push(`本文が長い（${bodyText.length}字）`);\n\n  // 5. 出典リンク\n  if (draft.source_url !== src.link) errors.push('source_url が RSS のリンクと違う');\n  if (!body.includes(src.link)) errors.push('本文に出典リンクがない');\n\n  // 6. 必須の見出し\n  for (const h of ['何が起きたか', '影響を受ける製品', 'やるべきこと']) {\n    if (!body.includes(h)) warnings.push(`見出し「${h}」がない`);\n  }\n\n  // 7. CVE 番号：原文にないものは NG\n  const cves = [...new Set((title + ' ' + bodyText).match(/CVE-\\d{4}-\\d{4,}/g) || [])];\n  for (const cve of cves) {\n    if (!srcText.includes(cve)) errors.push(`原文にないCVE番号：${cve}`);\n  }\n\n  // 8. 数字：原文にないものは警告（全角を半角にそろえてから比べる）\n  const toHalf = s => s.replace(/[０-９．]/g, c => String.fromCharCode(c.charCodeAt(0) - 0xFEE0));\n  const srcHalf = toHalf(srcText);\n  const nums = [...new Set(toHalf(bodyText).match(/\\d+(\\.\\d+)?/g) || [])];\n  const unknown = nums.filter(n => n.length >= 2 && !srcHalf.includes(n));\n  if (unknown.length) warnings.push(`原文に見つからない数字：${unknown.slice(0, 10).join(', ')}`);\n}\n\nreturn {\n  json: {\n    pass: errors.length === 0,\n    errors,\n    warnings,\n    draft,\n    source_title: src.title,\n    source_url: src.link,\n    raw_end: raw.slice(-150),\n  },\n};"
      },
